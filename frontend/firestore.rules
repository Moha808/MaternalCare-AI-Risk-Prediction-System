rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isHealthWorker() {
      return isAuthenticated() && getUserData().role == 'health_worker';
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    // ── users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Any logged-in user can read user profiles (needed for name lookups)
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }
    
    // ── patients ───────────────────────────────────────────────────────────
    match /patients/{patientId} {
      // Any authenticated health worker or admin can READ any patient record.
      // This is required so the dashboard can fetch all patients and filter
      // assignment client-side. Patients can only read their own record.
      allow read: if isOwner(patientId) || isAdmin() || isHealthWorker();

      // Only the patient themselves (on registration) or admin can CREATE
      allow create: if isOwner(patientId) || isAdmin();

      // Patient can update their own record (e.g. assigning a caseworker).
      // Health workers can update a patient record to claim/assign themselves.
      // Admin can update any record.
      allow update: if isOwner(patientId) || isAdmin() || isHealthWorker();

      allow delete: if isAdmin();
    }
    
    // ── assessments ────────────────────────────────────────────────────────
    match /assessments/{assessmentId} {
      // Patients can read their own assessments.
      // Health workers can read assessments of ANY patient (they filter client-side).
      // Admin can read all.
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        isAdmin() ||
        isHealthWorker()
      );
      
      // Only the patient themselves or admin can create an assessment
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid || 
        isAdmin()
      );
      
      allow update, delete: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || isAdmin()
      );
    }
    
    // ── alerts ─────────────────────────────────────────────────────────────
    match /alerts/{alertId} {
      // Patients can read their own alerts.
      // Health workers can read all alerts (filtered client-side to their patients).
      // Admin can read all.
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isAdmin() ||
        isHealthWorker()
      );
      
      // Any authenticated user (i.e. patient) can create an alert on submit
      allow create: if isAuthenticated();
      
      // Health workers and admins can acknowledge (update) alerts
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isHealthWorker()
      );
      
      allow delete: if isAdmin();
    }
    
    // ── appointments ───────────────────────────────────────────────────────
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        resource.data.healthWorkerId == request.auth.uid ||
        isAdmin()
      );
      
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        request.resource.data.healthWorkerId == request.auth.uid ||
        isAdmin()
      );
      
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        resource.data.healthWorkerId == request.auth.uid ||
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }
  }
}
